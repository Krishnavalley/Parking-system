# MongoDB Atlas connection string (get from Atlas dashboard)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parking?retryWrites=true&w=majority

# JWT secret (use a long random string in production)
JWT_SECRET=change-this-secret

# Frontend URL (your Netlify URL, for CORS)
CORS_ORIGIN=https://your-app.netlify.app

# Parking rate per hour
RATE_PER_HOUR=20

# Default slot count
DEFAULT_SLOT_COUNT=50

# Default admin password (change after first login!)
DEFAULT_ADMIN_PASSWORD=admin123
